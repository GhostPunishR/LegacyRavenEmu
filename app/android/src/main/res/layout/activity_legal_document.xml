<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/raven_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/raven_toolbar"
        android:elevation="4dp"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:titleTextColor="@color/raven_text_primary" />

    <ScrollView
        android:id="@+id/documentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbarStyle="outsideOverlay">

        <TextView
            android:id="@+id/documentText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="@color/raven_text_secondary"
            android:textIsSelectable="true"
            android:lineSpacingMultiplier="1.15" />
    </ScrollView>
</LinearLayout>
